{
    "title": "Forge CI Job Details",
    "description": "Shows recent Forge GitHub Actions job executions with repository, runner, label, queue, and duration details.",
    "inputs": {
        "input_global_time": {
            "options": {
                "defaultValue": "-24h@h,now",
                "token": "global_time"
            },
            "title": "Global Time Range",
            "type": "input.timerange"
        },
        "input_tenant": {
            "context": {},
            "dataSources": {},
            "options": {
                "defaultValue": "*",
                "items": ${jsonencode(
                    concat(
                        [{ label = "All", value = "*" }],
                        [for tenant in tenants : { label = tenant, value = tenant }]
                    )
                )},
                "token": "tenant"
            },
            "title": "Forge Tenant",
            "type": "input.dropdown"
        },
        "input_result": {
            "options": {
                "defaultValue": "*",
                "items": [
                    {
                        "label": "All",
                        "value": "*"
                    },
                    {
                        "label": "Success",
                        "value": "success"
                    },
                    {
                        "label": "Failure",
                        "value": "failure"
                    },
                    {
                        "label": "Cancelled",
                        "value": "cancelled"
                    },
                    {
                        "label": "Skipped",
                        "value": "skipped"
                    }
                ],
                "token": "result"
            },
            "title": "CI Result",
            "type": "input.dropdown"
        },
        "input_repository": {
            "options": {
                "defaultValue": "*",
                "token": "repository"
            },
            "title": "Repository Contains",
            "type": "input.text"
        },
        "input_runner_group": {
            "options": {
                "defaultValue": "*",
                "token": "runner_group"
            },
            "title": "Runner Group Contains",
            "type": "input.text"
        },
        "input_instance": {
            "options": {
                "defaultValue": "*",
                "token": "instance_id"
            },
            "title": "Instance or Runner Contains",
            "type": "input.text"
        }
    },
    "defaults": {
        "dataSources": {
            "ds.o11y": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            },
            "ds.search": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            }
        }
    },
    "visualizations": {
        "ci_job_details_table": {
            "containerOptions": {},
            "dataSources": {
                "primary": "ci_job_details_search"
            },
            "eventHandlers": [],
            "options": {
                "count": 50
            },
            "showLastUpdated": true,
            "showProgressBar": false,
            "title": "CI Job Details",
            "type": "splunk.table"
        }
    },
    "dataSources": {
        "ci_job_details_search": {
            "name": "Forge CI job details",
            "options": {
                "enableSmartSources": true,
                "query": "index=\"${splunk_index}\" forgecicd_log_type=\"runner-job-event\"\n| eval ci_result='workflow_job.conclusion'\n| eval repository='repository.full_name'\n| eval workflow_name='workflow_job.name'\n| eval workflow_run_id='workflow_job.run_id'\n| eval workflow_run_attempt='workflow_job.run_attempt'\n| eval workflow_job_id='workflow_job.id'\n| eval created_at='workflow_job.created_at'\n| eval started_at='workflow_job.started_at'\n| eval completed_at='workflow_job.completed_at'\n| eval runner_group='workflow_job.runner_group_name'\n| eval runner_name='workflow_job.runner_name'\n| eval run_url='workflow_job.html_url'\n| eval labels=mvjoin('workflow_job.labels{}', \", \")\n| where \"$tenant$\"=\"*\" OR forgecicd_tenant=\"$tenant$\"\n| where \"$result$\"=\"*\" OR ci_result=\"$result$\"\n| where \"$repository$\"=\"*\" OR like(repository, \"%$repository$%\")\n| where \"$runner_group$\"=\"*\" OR like(runner_group, \"%$runner_group$%\")\n| where \"$instance_id$\"=\"*\" OR like(forgecicd_instance_id, \"%$instance_id$%\") OR like(runner_name, \"%$instance_id$%\")\n| eval created_epoch=strptime(created_at, \"%Y-%m-%dT%H:%M:%SZ\")\n| eval started_epoch=strptime(started_at, \"%Y-%m-%dT%H:%M:%SZ\")\n| eval completed_epoch=strptime(completed_at, \"%Y-%m-%dT%H:%M:%SZ\")\n| eval queue_sec=started_epoch-created_epoch, duration_sec=completed_epoch-started_epoch, total_sec=completed_epoch-created_epoch\n| eval queue_time=if(isnotnull(queue_sec), tostring(queue_sec, \"duration\"), null())\n| eval run_duration=if(isnotnull(duration_sec), tostring(duration_sec, \"duration\"), null())\n| eval total_duration=if(isnotnull(total_sec), tostring(total_sec, \"duration\"), null())\n| table _time run_url ci_result forgecicd_tenant repository workflow_name workflow_run_id workflow_run_attempt workflow_job_id runner_group runner_name labels created_at started_at completed_at queue_time run_duration total_duration queue_sec duration_sec total_sec forgecicd_instance_id\n| sort - _time",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "type": "ds.search"
        }
    },
    "layout": {
        "globalInputs": [
            "input_global_time",
            "input_tenant",
            "input_result",
            "input_repository",
            "input_runner_group",
            "input_instance"
        ],
        "layoutDefinitions": {
            "layout_6CHuojec": {
                "options": {
                    "gutterSize": 9
                },
                "structure": [
                    {
                        "item": "ci_job_details_table",
                        "position": {
                            "h": 974,
                            "w": 1200,
                            "x": 0,
                            "y": 0
                        },
                        "type": "block"
                    }
                ],
                "type": "grid"
            }
        },
        "options": {},
        "tabs": {
            "items": [
                {
                    "label": "CI Job Details",
                    "layoutId": "layout_6CHuojec"
                }
            ]
        }
    },
    "applicationProperties": {
        "collapseNavigation": true
    }
}
