{
    "title": "Forge Tenant Logs",
    "description": "Displays Forge runner logs for a selected tenant, log type, and time range.",
    "inputs": {
        "input_4A2iEpn6": {
            "options": {
                "defaultValue": "*",
                "token": "text_9yxn14bn"
            },
            "title": "Forge Instance ID",
            "type": "input.text"
        },
        "input_ch5zNZ2X": {
            "dataSources": {
                "primary": "ds_5a4R8xaz"
            },
            "options": {
                "defaultValue": "",
                "items": [
                    {
                        "label": "All",
                        "value": "*"
                    }
                ],
                "token": "dd_ZlvrLiNG"
            },
            "title": "Forge Log Type",
            "type": "input.dropdown"
        },
        "input_global_trp": {
            "options": {
                "defaultValue": "-60m@m,now",
                "token": "global_time"
            },
            "title": "Global Time Range",
            "type": "input.timerange"
        },
        "input_uFiEIG6X": {
            "context": {},
            "dataSources": {},
            "options": {
                "items": ${jsonencode(
                    concat(
                        [{ label = "Select Tenant", value = "-" }],
                        [for tenant in tenants : { label = tenant, value = tenant }]
                    )
                )},
                "selectFirstSearchResult": true,
                "token": "dd_8enHUmpH"
            },
            "title": "Forge Tenant",
            "type": "input.dropdown"
        }
    },
    "defaults": {
        "dataSources": {
            "ds.o11y": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            },
            "ds.search": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            }
        }
    },
    "visualizations": {
        "viz_KuqTQOYc": {
            "containerOptions": {},
            "context": {},
            "dataSources": {
                "primary": "ds_iONxCEsT"
            },
            "options": {},
            "showLastUpdated": false,
            "showProgressBar": false,
            "description": "Shows retained raw Forge events for the selected tenant, log type, instance, and global time range. Healthy is not determined by row count; an empty result can mean no matching retained events. Action: correlate request, workflow-job, run, runner, instance, and region identifiers with the dashboard that identified impact. Raw logs provide evidence but do not assign ownership by themselves.",
            "title": "Which tenant log events match the investigation?",
            "type": "splunk.events"
        }
    },
    "dataSources": {
        "ds_5a4R8xaz": {
            "name": "log type list",
            "options": {
                "query": "index=\"${splunk_index}\" | stats count by forgecicd_log_type | table forgecicd_log_type",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "type": "ds.search"
        },
        "ds_iONxCEsT": {
            "name": "logs",
            "options": {
                "query": "index=\"${splunk_index}\" forgecicd_tenant=\"$dd_8enHUmpH$\" (forgecicd_log_type=\"$dd_ZlvrLiNG$\" OR (sourcetype=\"forgecicd:runner-logs:s3\" source=\"*.json\"))\n| eval runner_job_key=if(sourcetype=\"forgecicd:runner-logs:s3\",replace(source,\"\\.(?:log|json)$\",\"\"),null())\n| eval runner_job_json=if(sourcetype=\"forgecicd:runner-logs:s3\" AND match(source,\"\\.json$\"),_raw,null())\n| eventstats latest(runner_job_json) as runner_job_json by runner_job_key\n| spath input=runner_job_json path=repository.full_name output=repository\n| spath input=runner_job_json path=workflow_job.name output=job_name\n| spath input=runner_job_json path=workflow_job.workflow_name output=workflow_name\n| spath input=runner_job_json path=workflow_job.run_id output=workflow_run_id\n| spath input=runner_job_json path=workflow_job.run_attempt output=workflow_run_attempt\n| spath input=runner_job_json path=workflow_job.id output=workflow_job_id\n| spath input=runner_job_json path=workflow_job.conclusion output=ci_result\n| spath input=runner_job_json path=workflow_job.runner_group_name output=runner_group\n| spath input=runner_job_json path=workflow_job.runner_name output=runner_name\n| spath input=runner_job_json path=workflow_job.html_url output=run_url\n| spath input=runner_job_json path=workflow_job.created_at output=created_at\n| spath input=runner_job_json path=workflow_job.started_at output=started_at\n| spath input=runner_job_json path=workflow_job.completed_at output=completed_at\n| spath input=runner_job_json path=workflow_job.labels{} output=labels\n| eval repository=coalesce(repository,github_org.\"/\".github_repo), workflow_run_id=coalesce(workflow_run_id,workflow_run), workflow_run_attempt=coalesce(workflow_run_attempt,attempt), workflow_job_id=coalesce(workflow_job_id,job_id), labels=mvjoin(labels,\", \")\n| eval forgecicd_type=coalesce(forgecicd_type,case(match(runner_name,\"^i-[a-zA-Z0-9]+$\"),\"ec2\",match(runner_name,\"^[a-zA-Z0-9_-]+-[a-z0-9]+-runner-[a-zA-Z0-9]+$\"),\"arc\"))\n| eval forgecicd_instance_id=coalesce(forgecicd_instance_id,if(isnotnull(forgecicd_type),runner_name,null()))\n| where \"$dd_ZlvrLiNG$\"=\"*\" OR forgecicd_log_type=\"$dd_ZlvrLiNG$\"\n| where \"$text_9yxn14bn$\"=\"*\" OR forgecicd_instance_id=\"$text_9yxn14bn$\" OR runner_name=\"$text_9yxn14bn$\"\n| fields - runner_job_json runner_job_key\n| sort _time asc"
            },
            "type": "ds.search"
        },
        "ds_x8AMw4ri": {
            "name": "tenant list",
            "options": {
                "query": "index=\"${splunk_index}\" | stats count by forgecicd_tenant | table forgecicd_tenant",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "type": "ds.search"
        }
    },
    "layout": {
        "globalInputs": [
            "input_global_trp",
            "input_uFiEIG6X",
            "input_ch5zNZ2X",
            "input_4A2iEpn6"
        ],
        "layoutDefinitions": {
            "layout_1": {
                "options": {
                    "height": 790,
                    "width": 1440
                },
                "structure": [
                    {
                        "item": "viz_KuqTQOYc",
                        "position": {
                            "h": 626,
                            "w": 1440,
                            "x": 0,
                            "y": 0
                        },
                        "type": "block"
                    }
                ],
                "type": "grid"
            }
        },
        "options": {},
        "tabs": {
            "items": [
                {
                    "label": "Runner Logs",
                    "layoutId": "layout_1"
                }
            ]
        }
    },
    "applicationProperties": {
        "collapseNavigation": true
    }
}
