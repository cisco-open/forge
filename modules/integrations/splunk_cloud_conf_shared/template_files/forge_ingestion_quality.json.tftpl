{
    "applicationProperties": {
        "collapseNavigation": true,
        "hideEdit": false,
        "hideExport": false,
        "hideOpenInSearch": false
    },
    "dataSources": {
        "missing_fields_search": {
            "name": "Missing structured fields",
            "options": {
                "enableSmartSources": true,
                "query": "index=\"${splunk_index}\" sourcetype IN (\"forgecicd:runner-logs:s3\",\"kube:container:runner\",\"kube:container:runner-logs\",\"aws:cloudwatchlogs\",\"aws:cloudwatchlogs:forgecicd\")\n| eval missing_tenant=if(isnull(forgecicd_tenant),1,0)\n| eval missing_type=if(sourcetype IN (\"kube:container:runner\",\"kube:container:runner-logs\") AND isnull(forgecicd_type),1,0)\n| eval missing_log_type=if(isnull(forgecicd_log_type),1,0)\n| stats count as events\n        sum(missing_tenant) as missing_tenant\n        sum(missing_type) as missing_type\n        sum(missing_log_type) as missing_log_type\n        dc(source) as sources\n        by sourcetype\n| eval missing_tenant_pct=round(100*missing_tenant/events,2),\n       missing_type_pct=round(100*missing_type/events,2),\n       missing_log_type_pct=round(100*missing_log_type/events,2)\n| sort - missing_tenant_pct - events\n",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "type": "ds.search"
        },
        "source_inventory_search": {
            "name": "Top sources",
            "options": {
                "enableSmartSources": true,
                "query": "| tstats count where index=\"${splunk_index}\" by sourcetype source host\n| sort - count\n| head 100\n",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "type": "ds.search"
        },
        "sourcetype_inventory_search": {
            "name": "Sourcetype inventory",
            "options": {
                "enableSmartSources": true,
                "query": "| tstats count where index=\"${splunk_index}\" by sourcetype\n| sort - count\n",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "type": "ds.search"
        },
        "volume_anomaly_search": {
            "name": "High-volume sourcetype trend",
            "options": {
                "enableSmartSources": true,
                "query": "| tstats count where index=\"${splunk_index}\" by _time sourcetype span=15m\n| timechart span=15m sum(count) as events by sourcetype limit=10\n",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "type": "ds.search"
        }
    },
    "defaults": {
        "dataSources": {
            "ds.search": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            }
        }
    },
    "description": "Splunk ingestion volume, missing structured fields, and source inventory.",
    "inputs": {
        "input_global_time": {
            "options": {
                "defaultValue": "-24h@h,now",
                "token": "global_time"
            },
            "title": "Global Time Range",
            "type": "input.timerange"
        },
        "input_tenant": {
            "options": {
                "defaultValue": "*",
                "items": ${jsonencode(
                    concat(
                        [{ label = "All", value = "*" }],
                        [for tenant in tenants : { label = tenant, value = tenant }]
                    )
                )},
                "token": "tenant"
            },
            "title": "Forge Tenant",
            "type": "input.dropdown"
        }
    },
    "layout": {
        "globalInputs": [
            "input_global_time",
            "input_tenant"
        ],
        "layoutDefinitions": {
            "layout": {
                "options": {
                    "gutterSize": 9
                },
                "structure": [
                    {
                        "item": "missing_fields_table",
                        "position": {
                            "h": 380,
                            "w": 1200,
                            "x": 0,
                            "y": 0
                        },
                        "type": "block"
                    },
                    {
                        "item": "volume_anomaly_chart",
                        "position": {
                            "h": 360,
                            "w": 740,
                            "x": 0,
                            "y": 380
                        },
                        "type": "block"
                    },
                    {
                        "item": "sourcetype_inventory_table",
                        "position": {
                            "h": 360,
                            "w": 460,
                            "x": 600,
                            "y": 740
                        },
                        "type": "block"
                    },
                    {
                        "item": "source_inventory_table",
                        "position": {
                            "h": 420,
                            "w": 600,
                            "x": 0,
                            "y": 1160
                        },
                        "type": "block"
                    }
                ],
                "type": "grid"
            }
        },
        "options": {},
        "tabs": {
            "items": [
                {
                    "label": "Ingestion Quality",
                    "layoutId": "layout"
                }
            ]
        }
    },
    "title": "Forge Ingestion Quality",
    "visualizations": {
        "missing_fields_table": {
            "dataSources": {
                "primary": "missing_fields_search"
            },
            "options": {
                "count": 50
            },
            "showLastUpdated": true,
            "showProgressBar": false,
            "description": "Answers \"Which events are missing structured fields?\" using records that matched an explicit failure or actionable condition. Healthy: no rows, unless the panel documents an expected baseline. Failure: one or more rows persist or affect workflow jobs. Action: start with tenant, repository, region, job or run ID, and the named AWS or Kubernetes resource, then inspect the adjacent workflow stage.",
            "title": "Which events are missing structured fields?",
            "type": "splunk.table"
        },
        "source_inventory_table": {
            "dataSources": {
                "primary": "source_inventory_search"
            },
            "options": {
                "count": 50
            },
            "showLastUpdated": true,
            "showProgressBar": false,
            "description": "Answers \"Which sources produce the most events?\" for the selected filters and time range. Healthy depends on the workflow stage and is not inferred from a high count alone. Action: identify the affected tenant and resource, then use the next causal-stage panel or raw details to verify impact.",
            "title": "Which sources produce the most events?",
            "type": "splunk.table"
        },
        "sourcetype_inventory_table": {
            "dataSources": {
                "primary": "sourcetype_inventory_search"
            },
            "options": {
                "count": 40
            },
            "showLastUpdated": true,
            "showProgressBar": false,
            "description": "Answers \"Which sourcetypes are arriving?\" for the selected filters and time range. Healthy depends on the workflow stage and is not inferred from a high count alone. Action: identify the affected tenant and resource, then use the next causal-stage panel or raw details to verify impact.",
            "title": "Which sourcetypes are arriving?",
            "type": "splunk.table"
        },
        "volume_anomaly_chart": {
            "dataSources": {
                "primary": "volume_anomaly_search"
            },
            "options": {},
            "showLastUpdated": true,
            "showProgressBar": false,
            "description": "Answers \"Is ingestion volume changing unexpectedly?\" with a time series over the selected global range. Healthy: error, retry, delay, or backlog series remain at the established baseline; activity volume alone is not a failure. Failure: a sustained adverse series aligns with affected jobs or resources. Action: use the actionable table above for tenant and resource identifiers before opening raw events.",
            "title": "Is ingestion volume changing unexpectedly?",
            "type": "splunk.line"
        }
    }
}
